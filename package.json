{
  "name": "@hyperttp/adapter-axios",
  "version": "0.2.0",
  "private": false,
  "description": "",
  "keywords": [
    "events",
    "in-memory",
    "typescript"
  ],
  "homepage": "https://github.com/IT-IF-OR/hyperttp-adapter-axios#readme",
  "bugs": {
    "url": "https://github.com/IT-IF-OR/hyperttp-adapter-axios/issues"
  },
  "license": "MIT",
  "author": "dirold2",
  "repository": {
    "type": "git",
    "url": "https://github.com/IT-IF-OR/hyperttp-adapter-axios.git"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "!dist/**/*.map"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "./dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "format": "oxlint --fix . && oxfmt .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "node ../../scripts/build-package.ts",
    "clean": "node --input-type=module -e 'import { rmSync } from \"node:fs\"; rmSync(\"dist\", { recursive: true, force: true });'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hyperttp/core": "^3.0.3",
    "hyperttp": "^0.7.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "chalk": "^6.0.1",
    "dotenv-cli": "^11.1.0",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.90.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "@hyperttp/protocol-rest": "^0.1.1"
  },
  "peerDependencies": {
    "@hyperttp/types": "^0.5.3",
    "axios": "^1.21.0"
  },
  "engines": {
    "node": ">=18"
  }
}
